---
- name: Install and configure Nginx web server
  hosts: webservers
  become: true  # Runs tasks with root/sudo privileges

  tasks:
    - name: Ensure package list is up to date (Debian/Ubuntu)
      apt:
        update_cache: yes
      when: ansible_os_family == "Debian"

    - name: Install Nginx package
      package:
        name: nginx
        state: present

    - name: Ensure Nginx service is running and enabled
      service:
        name: nginx
        state: started
        enabled: true
